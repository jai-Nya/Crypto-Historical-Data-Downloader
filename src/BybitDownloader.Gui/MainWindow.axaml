<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BybitDownloader.Gui.ViewModels"
        x:Class="BybitDownloader.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Bybit Perpetual Futures Downloader"
        Width="920" Height="680"
        MinWidth="760" MinHeight="520">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*">

    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="Bybit Perpetual Futures — 1-minute candle downloader"
                 FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Plan a period and symbols, preview the workload, then download resumable monthly Parquet chunks."
                 Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="Auto,200,Auto,200" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            IsEnabled="{Binding CanEdit}"
            ColumnSpacing="10" RowSpacing="8">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Period" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding PeriodModes}" SelectedItem="{Binding PeriodMode, Mode=TwoWay}" />

        <TextBlock Grid.Row="0" Grid.Column="2" Text="Category" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding CategoryModes}" SelectedItem="{Binding CategoryMode, Mode=TwoWay}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Year" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Year, Mode=TwoWay}" />

        <TextBlock Grid.Row="1" Grid.Column="2" Text="Month (yyyy-MM)" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Month, Mode=TwoWay}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="From (yyyy-MM-dd)" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FromDate, Mode=TwoWay}" />

        <TextBlock Grid.Row="2" Grid.Column="2" Text="To (yyyy-MM-dd)" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ToDate, Mode=TwoWay}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Symbols" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding SymbolModes}" SelectedItem="{Binding SymbolMode, Mode=TwoWay}" />

        <TextBlock Grid.Row="3" Grid.Column="2" Text="Preset" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="3" HorizontalAlignment="Stretch" IsEnabled="{Binding IsScreenMode}"
                  ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset, Mode=TwoWay}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Symbol list" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" IsEnabled="{Binding IsExplicitMode}"
                 PlaceholderText="BTCUSDT, ETHUSDT, ..." Text="{Binding SymbolsText, Mode=TwoWay}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Output folder" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding OutputRoot, Mode=TwoWay}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="10" Margin="0,0,0,12">
      <Button Grid.Column="0" Content="Preview plan" Padding="14,6" Command="{Binding PreviewCommand}" />
      <Button Grid.Column="1" Content="Start download" Padding="14,6" Command="{Binding StartCommand}" />
      <Button Grid.Column="2" Content="Validate output" Padding="14,6" Command="{Binding ValidateCommand}" />
      <Button Grid.Column="3" Content="Cancel" Padding="14,6" Command="{Binding CancelCommand}" />
      <TextBlock Grid.Column="4" Text="Workers" VerticalAlignment="Center" Margin="12,0,0,0" />
      <TextBox Grid.Column="5" Width="60" Text="{Binding WorkersText, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
      <CheckBox Grid.Column="6" Content="Include forming candle" Margin="12,0,0,0"
                IsChecked="{Binding IncludeForming, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
    </Grid>

    <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,12">
      <ProgressBar Minimum="0" Maximum="100" Height="10" Value="{Binding ProgressValue}" />
      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding PlanSummary}" Opacity="0.85" TextWrapping="Wrap"
                 FontFamily="Consolas,Menlo,monospace" />
    </StackPanel>

    <Border Grid.Row="4" BorderBrush="#33000000" BorderThickness="1" CornerRadius="6">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,90,90" Background="#14000000" Margin="0">
          <TextBlock Grid.Column="0" Text="Chunk" Margin="10,6" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Status" Margin="10,6" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="Rows" Margin="10,6" FontWeight="SemiBold" HorizontalAlignment="Right" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChunkProgressRow">
              <Grid ColumnDefinitions="*,90,90">
                <TextBlock Grid.Column="0" Text="{Binding ChunkId}" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" />
                <TextBlock Grid.Column="2" Text="{Binding RowsText}" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

  </Grid>
</Window>
